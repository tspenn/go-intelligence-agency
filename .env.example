# ─── Supabase (shared project — same as FRIDAY Canvas, GoShop, GoTRVL, LnkLokr) ─
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── VAPID public key for Web Push notifications ──────────────────────────────
# Same key used by all sister apps (FRIDAY Canvas, GoShop, etc.) since it's
# tied to the project. Get it from any sister app's .env or push code.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ─── App Mode ─────────────────────────────────────────────────────────────────
# Controls which UI ships:
#   secret_agent → my-secret-agent.com (Entry tier, sentence form default,
#                  4-mission limit, 10-day free trial → $4.99/mo)
#   gia          → www.go-i-agency.com (upgrade product, Command Center default,
#                  unlimited missions, $14.99/mo or $29.99/mo)
# This repo deploys as GIA — set gia in production.
VITE_APP_MODE=gia

# ─── Supabase Edge Function secrets (already set in shared project — do not recreate)
# WEB-PUSH_PUBLIC_KEY    ← already exists
# WEB_PUSH_PRIVATE_KEY   ← already exists
# WEB_PUSH_CONTACT-EMAIL ← already exists
# RESEND_API_KEY         ← already exists (shared — do not overwrite)
# TWILIO_ACCOUNT_SID     ← already exists
# TWILIO_API_KEY         ← already exists
# TWILIO_API_SECRET      ← already exists
# TWILIO_FROM_NUMBER     ← already exists

# ─── GIA-specific secrets (set separately to avoid conflicts with My Secret Agent)
# supabase secrets set DIGEST_FROM_EMAIL_GIA=agency@skylandapps.com --project-ref psbdjnqcjpxapypcfigx
DIGEST_FROM_EMAIL_GIA=agency@skylandapps.com
